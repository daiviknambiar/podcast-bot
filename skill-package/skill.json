{
  "manifest": {
    "publishingInformation": {
      "locales": {
        "en-US": {
          "name": "PodBot",
          "summary": "Plays the latest Morning Brew Daily and answers what-you-just-heard.",
          "description": "PodBot plays the newest Morning Brew Daily episode and can answer questions about what was just said by analyzing the last ~75 seconds of audio with Gemini.",
          "examplePhrases": [
            "Alexa, ask pod bot to play Morning Brew",
            "Alexa, ask pod bot what is compute",
            "Alexa, ask pod bot what did I just miss"
          ]
        }
      },
      "isAvailableWorldwide": true,
      "testingInstructions": "Try: 'Alexa, ask pod bot to play Morning Brew', then 'what did I just miss?'.",
      "category": "NEWS"
    },
    "apis": {
      "custom": {
        "endpoint": {
          "uri": "arn:aws:lambda:us-east-1:850211188617:function:8731ea2f-6df5-4445-a307-582ff944ab13:Release_0"
        },
        "regions": {
          "EU": {
            "endpoint": {
              "uri": "arn:aws:lambda:eu-west-1:850211188617:function:8731ea2f-6df5-4445-a307-582ff944ab13:Release_0"
            }
          },
          "FE": {
            "endpoint": {
              "uri": "arn:aws:lambda:us-west-2:850211188617:function:8731ea2f-6df5-4445-a307-582ff944ab13:Release_0"
            }
          }
        },
        "interfaces": [
          { "type": "AUDIO_PLAYER" }
        ]
      }
    },
    "privacyAndCompliance": {
